@model SurgiTech.Models.SurgicalInstrument
@{
    Layout = null;
    ViewData["Title"] = "Add Instrument";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Instrument - SurgiTech Admin</title>
    <link rel="stylesheet" href="~/css/dashboard.css">
    <link rel="stylesheet" href="~/css/admin-extra.css">
    <link rel="stylesheet" href="~/css/dashboard-mobile.css" asp-append-version="true">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <div class="sidebar-overlay"></div>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo">
                <i data-lucide="scissors"></i>
                <span>SurgiTech</span>
            </div>

            <nav class="nav-menu">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-item"><i data-lucide="layout-dashboard"></i> Dashboard</a>
                <a asp-controller="Admin" asp-action="Inventory" class="nav-item active"><i data-lucide="box"></i> Inventory</a>
                <a asp-controller="Admin" asp-action="Orders" class="nav-item"><i data-lucide="shopping-cart"></i> Orders</a>
                <a asp-controller="Shop" asp-action="Index" class="nav-item"><i data-lucide="store"></i> Client Shop</a>
            </nav>

            <div class="sidebar-footer">
                <a href="#" class="nav-item"><i data-lucide="settings"></i> Settings</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-item" style="width:100%; border:none; background:none; cursor:pointer;">
                        <i data-lucide="log-out"></i> Log out
                    </button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <button class="mobile-menu-btn" aria-label="Open menu">
                    <i data-lucide="menu"></i>
                </button>
                <div class="user-greeting">
                    <h1>Add Instrument</h1>
                    <p>Add a new surgical instrument to the catalog</p>
                </div>
            </header>

            <div class="mgmt-form-card">
                <form asp-action="AddInstrument" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="mgmt-flash" style="display:block;"></div>

                    <label class="field-label">Name</label>
                    <input asp-for="Name" class="text-input" placeholder="e.g. Mayo Scissors" />
                    <span asp-validation-for="Name" class="danger-text"></span>

                    <label class="field-label">Category</label>
                    <input asp-for="Category" class="text-input" placeholder="e.g. Scissors" />
                    <span asp-validation-for="Category" class="danger-text"></span>

                    <label class="field-label">Material Grade</label>
                    <input asp-for="MaterialGrade" class="text-input" placeholder="e.g. German Stainless Steel" />

                    <label class="field-label">Unit Price</label>
                    <input asp-for="UnitPrice" class="text-input" type="number" step="0.01" />
                    <span asp-validation-for="UnitPrice" class="danger-text"></span>

                    <label class="field-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" class="text-input" type="number" />

                    <label class="field-label">Photo</label>
                    <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="text-input" />
                    <span asp-validation-for="ImageUrl" class="danger-text"></span>

                    <div style="margin-top:20px; display:flex; gap:10px;">
                        <button type="submit" class="btn-primary">Add Instrument</button>
                        <a asp-action="Inventory" class="btn-edit">Cancel</a>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script src="~/js/dashboard-mobile.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
</body>
</html>