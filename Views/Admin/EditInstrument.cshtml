@model SurgiTech.Models.SurgicalInstrument
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit @Model.Name - SurgiTech Admin</title>
    <link rel="stylesheet" href="~/css/dashboard.css">
    <link rel="stylesheet" href="~/css/admin-extra.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo">
                <i data-lucide="scissors"></i>
                <span>SurgiTech</span>
            </div>

            <nav class="nav-menu">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-item"><i data-lucide="layout-dashboard"></i> Dashboard</a>
                <a asp-controller="Admin" asp-action="Inventory" class="nav-item active"><i data-lucide="box"></i> Inventory</a>
                <a asp-controller="Admin" asp-action="Orders" class="nav-item"><i data-lucide="shopping-cart"></i> Orders</a>
                <a asp-controller="Admin" asp-action="Reports" class="nav-item"><i data-lucide="file-text"></i> Reports</a>
                <a asp-controller="Shop" asp-action="Index" class="nav-item"><i data-lucide="store"></i> Client Shop</a>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Admin" asp-action="Settings" class="nav-item"><i data-lucide="settings"></i> Settings</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <div class="user-greeting">
                    <h1>Edit instrument</h1>
                    <p>Update stock, pricing or details for this item</p>
                </div>
            </header>

            <div class="mgmt-form-card">
                <form asp-action="EditInstrument" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" required />

                    <label asp-for="Category">Category</label>
                    <input asp-for="Category" required />

                    <label asp-for="MaterialGrade">Material grade</label>
                    <input asp-for="MaterialGrade" />

                    <label asp-for="UnitPrice">Unit price</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" required />

                    <label asp-for="StockQuantity">Stock quantity</label>
                    <input asp-for="StockQuantity" type="number" min="0" required />

                    <label asp-for="ImageUrl">Image URL</label>
                    <input asp-for="ImageUrl" />

                    <div class="mgmt-form-actions">
                        <button type="submit" class="btn-save">Save changes</button>
                        <a asp-action="Inventory" class="btn-cancel">Cancel</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
    <script src="~/js/dashboard-mobile.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
