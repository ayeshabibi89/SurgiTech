@model SurgiTech.Controllers.OrderReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports - SurgiTech Admin</title>
    <link rel="stylesheet" href="~/css/dashboard.css">
    <link rel="stylesheet" href="~/css/admin-extra.css">
    <link rel="stylesheet" href="~/css/dashboard-mobile.css" asp-append-version="true">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <div class="sidebar-overlay"></div>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo">
                <i data-lucide="scissors"></i>
                <span>SurgiTech</span>
            </div>

            <nav class="nav-menu">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-item"><i data-lucide="layout-dashboard"></i> Dashboard</a>
                <a asp-controller="Admin" asp-action="Inventory" class="nav-item"><i data-lucide="box"></i> Inventory</a>
                <a asp-controller="Admin" asp-action="Orders" class="nav-item"><i data-lucide="shopping-cart"></i> Orders</a>
                <a asp-controller="Admin" asp-action="Reports" class="nav-item active"><i data-lucide="file-text"></i> Reports</a>
                <a asp-controller="Shop" asp-action="Index" class="nav-item"><i data-lucide="store"></i> Client Shop</a>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Admin" asp-action="Settings" class="nav-item"><i data-lucide="settings"></i> Settings</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-item" style="width:100%; border:none; background:none; cursor:pointer;">
                        <i data-lucide="log-out"></i> Log out
                    </button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <button class="mobile-menu-btn" aria-label="Open menu">
                    <i data-lucide="menu"></i>
                </button>
                <div class="user-greeting">
                    <h1>Order Status Report</h1>
                    <p>@Model.TotalOrders total orders &middot; @Model.TotalRevenue.ToString("C") total revenue</p>
                </div>
                <div class="header-actions">
                    <a asp-action="ExportOrdersCsv" class="btn-save">
                        <i data-lucide="download"></i> Download CSV
                    </a>
                </div>
            </header>

            <div class="report-summary-grid">
                @foreach (var s in Model.Summary)
                {
                    var badgeClass = s.Status switch
                    {
                        "Shipped" or "Delivered" => "badge-ok",
                        "Processing" => "badge-warn",
                        _ => "badge-info"
                    };
                    <div class="report-summary-card">
                        <span class="badge @badgeClass">@s.Status</span>
                        <div class="report-summary-count">@s.Count</div>
                        <div class="report-summary-label">order@(s.Count == 1 ? "" : "s")</div>
                        <div class="report-summary-total">@s.Total.ToString("C")</div>
                    </div>
                }
            </div>

            <div class="mgmt-header">
                <h2>All orders</h2>
            </div>

            <div class="mgmt-table-wrap">
                <table class="mgmt-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Hospital / Clinic</th>
                            <th>Placed</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Shipped" or "Delivered" => "badge-ok",
                                "Processing" => "badge-warn",
                                _ => "badge-info"
                            };
                            <tr>
                                <td data-label="Order">#ORD-@order.Id</td>
                                <td data-label="Hospital / Clinic">@order.HospitalName</td>
                                <td data-label="Placed">@order.OrderDate.ToString("MMM d, yyyy")</td>
                                <td data-label="Total">@order.TotalAmount.ToString("C")</td>
                                <td data-label="Status"><span class="badge @badgeClass">@order.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script src="~/js/dashboard-mobile.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
