@model List<SurgiTech.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    Layout = "_ShopLayout";
    var subtotal = Model.Sum(c => c.LineTotal);
    var shipping = subtotal > 0 ? (decimal)(ViewBag.ShippingFee ?? 25m) : 0m;
}

<section class="catalog-section">
    <div class="container">
        <div class="panel-head">
            <h2>Your cart</h2>
            <span class="text-dim">@Model.Sum(c => c.Quantity) item(s)</span>
        </div>

        @if (!Model.Any())
        {
            <p class="empty-state">Your cart is empty. <a asp-action="Index" class="see-all">Browse the catalog</a></p>
        }
        else
        {
            <div class="cart-layout">
                <div class="cart-items">
                    @foreach (var item in Model)
                    {
                        <div class="cart-row">
                            <div>
                                <div class="name">@item.Name</div>
                                <div class="unit">@item.UnitPrice.ToString("C") &times; @item.Quantity</div>
                            </div>
                            <form asp-action="UpdateQuantity" method="post" class="qty-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.InstrumentId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="qty-input" onchange="this.form.submit()" />
                            </form>
                            <div class="line-total">@item.LineTotal.ToString("C")</div>
                            <form asp-action="RemoveFromCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.InstrumentId" />
                                <button type="submit" class="remove-btn" aria-label="Remove">&#10005;</button>
                            </form>
                        </div>
                    }
                </div>

                <aside class="cart-summary">
                    <div class="summary-row"><span>Subtotal</span><span>@subtotal.ToString("C")</span></div>
                    <div class="summary-row"><span>Estimated shipping</span><span>@shipping.ToString("C")</span></div>
                    <div class="summary-row total"><span>Total</span><span>@((subtotal + shipping).ToString("C"))</span></div>

                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <label class="field-label" for="hospitalName">Hospital / clinic name</label>
                        <input type="text" id="hospitalName" name="hospitalName" placeholder="e.g. City Hospital Care" required class="text-input" />
                        <button type="submit" class="btn btn-primary place-order-btn">Place order</button>
                    </form>
                    <p class="summary-note">Orders ship within 2&ndash;4 business days of ISO clearance.</p>
                </aside>
            </div>
        }
    </div>
</section>
